tarefas = []
proximo_id = 1


def exibir_menu():
    print("\n" + "=" * 40)
    print("GERENCIADOR DE TAREFAS")
    print("=" * 40)
    print("1 - Adicionar tarefa")
    print("2 - Listar tarefas")
    print("3 - Concluir tarefa")
    print("4 - Remover tarefa")
    print("5 - Sair")
    print("=" * 40)


def adicionar_tarefa():
    global proximo_id

    print("\n--- ADICIONAR TAREFA ---")

    titulo = input("Tarefa: ").strip()

    if not titulo:
        print("O nome da tarefa não pode estar vazio.")
        return

    materia = input("Matéria: ").strip()

    tarefa = {
        "id": proximo_id,
        "titulo": titulo,
        "materia": materia if materia else "Geral",
        "concluida": False
    }

    tarefas.append(tarefa)
    print(f"Tarefa adicionada com sucesso. ID: {proximo_id}")

    proximo_id += 1


def listar_tarefas():
    print("\n--- LISTA DE TAREFAS ---")

    if not tarefas:
        print("Nenhuma tarefa cadastrada.")
        return

    for tarefa in tarefas:
        status = "Concluída" if tarefa["concluida"] else "Pendente"

        print(
            f"ID: {tarefa['id']} | "
            f"{status} | "
            f"{tarefa['titulo']} | "
            f"{tarefa['materia']}"
        )


def encontrar_tarefa(id_tarefa):
    for tarefa in tarefas:
        if tarefa["id"] == id_tarefa:
            return tarefa

    return None


def concluir_tarefa():
    print("\n--- CONCLUIR TAREFA ---")

    if not tarefas:
        print("Nenhuma tarefa cadastrada.")
        return

    try:
        id_tarefa = int(input("ID da tarefa: "))
    except ValueError:
        print("Digite um número válido.")
        return

    tarefa = encontrar_tarefa(id_tarefa)

    if tarefa is None:
        print("Tarefa não encontrada.")
        return

    if tarefa["concluida"]:
        print("A tarefa já está concluída.")
        return

    tarefa["concluida"] = True
    print("Tarefa concluída com sucesso.")


def remover_tarefa():
    print("\n--- REMOVER TAREFA ---")

    if not tarefas:
        print("Nenhuma tarefa cadastrada.")
        return

    try:
        id_tarefa = int(input("ID da tarefa: "))
    except ValueError:
        print("Digite um número válido.")
        return

    tarefa = encontrar_tarefa(id_tarefa)

    if tarefa is None:
        print("Tarefa não encontrada.")
        return

    tarefas.remove(tarefa)
    print("Tarefa removida com sucesso.")


while True:
    exibir_menu()

    try:
        opcao = int(input("Escolha uma opção: "))
    except ValueError:
        print("Digite um número válido.")
        continue

    if opcao == 1:
        adicionar_tarefa()

    elif opcao == 2:
        listar_tarefas()

    elif opcao == 3:
        concluir_tarefa()

    elif opcao == 4:
        remover_tarefa()

    elif opcao == 5:
        print("Programa encerrado.")
        break

    else:
        print("Opção inválida.")
